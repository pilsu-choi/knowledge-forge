# SaaS collector credentials, read by knowledge_forge.config.Settings
# (KF_-prefixed) and turned into authenticated collectors by
# collectors/saas/factory.py. Only fill in the source(s) you're actually
# using; each build_*_collector() raises a clear error if something
# required is missing. Requires the matching extra: pip install
# "knowledge-forge[slack,notion,google]".

# ─── Slack ──────────────────────────────────────────────────────────────
KF_SLACK_BOT_TOKEN=
# Comma-separated channel IDs to sync, e.g. "C0123,C0456". Optional if
# KF_SLACK_CHANNEL_PROJECT_MAP is set (its keys are used as the channel list).
KF_SLACK_CHANNELS=
# Optional: per-channel tenancy when one bot spans several projects' channels
# - inline JSON or a path to a JSON file, e.g. '{"C0123":"PRJ-A","C0456":"PRJ-B"}'.
# A channel missing from the map falls back to --project-id.
KF_SLACK_CHANNEL_PROJECT_MAP=

# ─── Notion ─────────────────────────────────────────────────────────────
KF_NOTION_TOKEN=
KF_NOTION_DATABASE_ID=

# ─── Google Drive ───────────────────────────────────────────────────────
# Service-account credentials: either the JSON itself (single line) or a
# path to the JSON file.
KF_GDRIVE_CREDENTIALS_JSON=
# Folder to sync; omit to sync every file the service account can see.
KF_GDRIVE_FOLDER_ID=

# ─── Gmail ──────────────────────────────────────────────────────────────
# Gmail uses a pre-authorized user OAuth token, not service-account
# delegation - both are paths to files produced by a one-off OAuth setup.
KF_GMAIL_CREDENTIALS_PATH=
KF_GMAIL_TOKEN_PATH=
KF_GMAIL_QUERY=

# ─── Embeddings (pgvector, wiki/embeddings.md) ───────────────────────────
# Whether `extract` embeds each document's KnowledgeObjects into
# knowledge_object_embeddings right after storing them (default off,
# opt-in like KF_DATABASE_URL). `extract --embed/--no-embed` overrides this
# per invocation; `knowledge-forge embed` backfills regardless of this flag.
KF_EMBEDDING_ENABLED=false
# Switch point for a future non-OpenAI embedding backend - only "openai" is
# implemented so far.
KF_EMBEDDING_PROVIDER=openai
KF_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY is NOT KF_-prefixed - the embedding provider reads it
# directly from the environment at construction time, same principle as
# OPENROUTER_API_KEY/ANTHROPIC_API_KEY not being duplicated into Settings.
OPENAI_API_KEY=

# ─── Agent runtime (harness, wiki/agent-runtime.md) ──────────────────────
# Separate from KF_LLM_PROVIDER above (that one's Knowledge Extraction) -
# "anthropic" (default) or "openai_compatible". "claude_agent_sdk" is
# deliberately not a valid value here, see agent-runtime.md.
KF_AGENT_PROVIDER=anthropic
KF_AGENT_MODEL=claude-sonnet-5
# Only used when KF_AGENT_PROVIDER=openai_compatible.
KF_AGENT_OPENAI_COMPATIBLE_MODEL=anthropic/claude-sonnet-5
KF_AGENT_OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# Hard cap on tool-call round trips per turn (agent/loop.py) - a safety net,
# not a tuning knob.
KF_AGENT_MAX_ITERATIONS=8
# Cross-session agent memory (agent/memory.py, write_memory tool) - plain
# markdown files, one per project_id, stored OUTSIDE the OKF tree on purpose.
KF_AGENT_MEMORY_DIR=./.knowledge-forge-state/agent-memory
# Credentials are NOT KF_-prefixed and NOT duplicated here - reuses whatever
# ANTHROPIC_API_KEY/OPENROUTER_API_KEY is already resolvable in the
# environment (same credentials Knowledge Extraction uses), read directly by
# the provider classes at construction time, same principle as every other
# provider in this file.

# ─── Auto-scheduling (serve) ─────────────────────────────────────────────
# Sources to auto-sync on an interval, started from inside `knowledge-forge
# serve` itself (wiki/scheduling.md "serve 자동 스케줄링") - starting the API
# server is then enough to also start periodic sync. Inline JSON array or a
# path to a file containing one; each entry is IngestRequest's fields plus
# `interval_seconds` (default 600). Empty/unset disables auto-scheduling.
# Example:
# KF_SCHEDULED_SOURCES=[{"source":"local","path":"/app/input","interval_seconds":600,"okf_dir":"/app/okf"}]
KF_SCHEDULED_SOURCES=
